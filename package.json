{
  "name": "lookalike-link-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only, explainable URL spoofing warnings for Chrome.",
  "license": "MIT",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:chrome": "playwright test --project=chrome",
    "check:package": "node scripts/package.mjs --check",
    "package": "node scripts/package.mjs",
    "data:unicode": "node scripts/unicode.mjs"
  },
  "dependencies": {
    "punycode": "2.3.1",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.1.32",
    "@types/node": "24.10.1",
    "@types/punycode": "2.1.4",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
